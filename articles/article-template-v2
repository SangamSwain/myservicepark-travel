<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>[Destination Title] - Travel Guide | MyServicePark</title>
  <meta name="description" content="Detailed travel guide, photo journal, and quick travel facts for [Destination Name]." />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="../style.css" />
</head>
<body>

  <!-- Navigation -->
  <header class="site-header">
    <div class="container nav-wrapper">
      <a href="../index.html" class="brand-logo">
        MyServicePark <span>Travel</span>
      </a>

      <button class="menu-toggle" aria-label="Toggle navigation">&#9776;</button>

      <nav class="nav-menu">
        <a href="../index.html" class="nav-link">Home</a>
        <a href="../destinations/index.html" class="nav-link">Destinations</a>
        <a href="#" class="nav-link active">Journal</a>
        <a href="https://myservicepark.com/" target="_blank" rel="noopener" class="nav-link nav-btn">Main Portal &nearr;</a>
      </nav>
    </div>
  </header>

  <!-- Article Container -->
  <article class="container">
    <header class="article-header">
      <span class="section-tag">[Category • District / Region]</span>
      <h1 class="section-title">[Insert Destination Title Here]</h1>
      <div class="article-meta-bar">
        <span>Published: [Month Year]</span> • <span>[X] Min Read</span> • <span>By [Author Name]</span>
      </div>
    </header>

    <!-- Infinite Instagram-Style Carousel -->
    <div class="insta-carousel-wrapper">
      <div class="insta-carousel-viewport">
        <div class="insta-badge">1 / 3</div>
        <button class="insta-nav-btn prev" aria-label="Previous image">&lsaquo;</button>
        <button class="insta-nav-btn next" aria-label="Next image">&rsaquo;</button>
        
        <div class="insta-carousel-track">
          <div class="insta-slide" data-location="[Location Name 1]" data-caption="[Detailed caption describing photo 1]">
            <img src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80" alt="Photo 1 description" />
          </div>
          <div class="insta-slide" data-location="[Location Name 2]" data-caption="[Detailed caption describing photo 2]">
            <img src="https://images.unsplash.com/photo-1432405972618-c60b0225b8f9?auto=format&fit=crop&w=1200&q=80" alt="Photo 2 description" />
          </div>
          <div class="insta-slide" data-location="[Location Name 3]" data-caption="[Detailed caption describing photo 3]">
            <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1200&q=80" alt="Photo 3 description" />
          </div>
        </div>
      </div>

      <!-- Caption Box Directly Under Active Image -->
      <div class="insta-caption-bar">
        <div class="insta-location-tag">📍 [Location Name 1]</div>
        <div class="insta-caption-text">[Detailed caption describing photo 1]</div>
        <div class="insta-dots"></div>
      </div>
    </div>

    <!-- Article Body Layout -->
    <div class="article-layout">
      
      <!-- Travel Quick Facts Sidebar -->
      <aside class="travel-quick-info">
        <h3 class="info-title">📍 Travel Quick Facts</h3>
        <div class="info-grid">
          <div class="info-item"><label>Location</label><span>[District / City, State]</span></div>
          <div class="info-item"><label>Best Time to Visit</label><span>[Oct to March / Winter]</span></div>
          <div class="info-item"><label>Nearest Transport</label><span>[Nearest Railway Station / Airport]</span></div>
          <div class="info-item"><label>Est. Daily Budget</label><span>[₹1,500 - ₹3,000 / day]</span></div>
          <div class="info-item"><label>Ideal Stay Duration</label><span>[2 Days / 1 Night]</span></div>
          <div class="info-item"><label>Local Speciality</label><span>[Famous Dish / Craft]</span></div>
        </div>

        <!-- Direct Portal Booking Link Button -->
        <a href="https://myservicepark.com/" target="_blank" rel="noopener" class="sidebar-action-btn">
          Book Trip on MyServicePark &rarr;
        </a>
      </aside>

      <!-- Main Text Body -->
      <div class="article-body">
        <h2>Overview & Atmosphere</h2>
        <p>Write an engaging introductory paragraph about the history, landscape, and why this location is worth visiting.</p>

        <h2>Top Things to Do</h2>
        <ul>
          <li><strong>[Key Spot 1]:</strong> Description of key attraction or activity.</li>
          <li><strong>[Key Spot 2]:</strong> Description of key attraction or activity.</li>
          <li><strong>[Key Spot 3]:</strong> Description of key attraction or activity.</li>
        </ul>

        <h2>Traveler Video Insights</h2>
        <div class="video-wrapper">
          <iframe src="https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ" title="Destination Video Guide" allowfullscreen></iframe>
        </div>

        <!-- Portal Booking Box -->
        <div class="booking-cta-box">
          <h3>Plan Your Journey to [Destination Name]</h3>
          <p>Book verified rental vehicles, local guides, and stay options directly through our portal.</p>
          <a href="https://myservicepark.com/" target="_blank" rel="noopener" class="booking-cta-btn">Access MyServicePark Booking Portal &rarr;</a>
        </div>
      </div>

    </div>
  </article>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <h3>MyServicePark <span>Travel</span></h3>
        <p>A minimalist travel magazine dedicated to highlighting the culture, landscapes, and unexplored destinations of Odisha, India.</p>
      </div>
      <div class="footer-links">
        <h4>Navigation</h4>
        <ul>
          <li><a href="../index.html">Home</a></li>
          <li><a href="../destinations/index.html">Destinations</a></li>
        </ul>
      </div>
      <div class="footer-links">
        <h4>Connect</h4>
        <ul>
          <li><a href="https://myservicepark.com/" target="_blank" rel="noopener">MyServicePark Portal</a></li>
        </ul>
      </div>
    </div>
    <div class="container footer-bottom">
      <p>&copy; 2026 MyServicePark Travel.</p>
    </div>
  </footer>

  <script src="../script.js"></script>
</body>
</html>
